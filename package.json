{
  "name": "japanese-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev-monorepo.js",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "local": "node scripts/prod-monorepo.js",
    "local:no-build": "node scripts/prod-monorepo.js --skip-build",
    "prod": "node scripts/prod-monorepo.js --public",
    "prod:no-build": "node scripts/prod-monorepo.js --public --skip-build",
    "study:commit": "node scripts/nightly-study-commit.mjs",
    "study:commit:dry": "node scripts/nightly-study-commit.mjs --dry-run",
    "kill:port": "node scripts/kill-port.js",
    "kill:api": "node scripts/kill-port.js 47833",
    "kill:prod-ports": "node scripts/kill-port.js 47833 47832",
    "build": "npm run build --workspace client",
    "typecheck": "npm run typecheck --workspace client",
    "preview": "npm run preview --workspace client",
    "test:save-day-result": "node scripts/test-save-day-result.cjs",
    "test:stage-progression": "node scripts/test-stage-progression.cjs"
  }
}
